# Razorpay test-mode credentials — from Dashboard > Settings > API Keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Groq API key — for the classifier's ambiguous-case path and the fallback agent
GROQ_API_KEY=
# Groq model id used by the classifier's LLM path (P3/P12 only). Verified
# working with strict JSON response_format as of 2026-08-23.
GROQ_MODEL=openai/gpt-oss-20b

# Local SQLite path
DATABASE_URL=sqlite:///./orchestrator.db

# Executor time-scale: 1.0 = real wall-clock scheduling. >1.0 fast-forwards
# demo/test runs (e.g. 3600 = 1 simulated hour per real second) by
# compressing the delay APScheduler waits before firing -- the execution
# logic itself (app/executor.py) is identical at any scale. See docs/architecture.md.
TIME_SCALE=1.0
